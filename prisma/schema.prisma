// Workshop Scheduler — schema
//
// Identity (User, School) + NextAuth adapter tables, plus the scheduling
// domain: ClassSection, WorkshopDefinition, ClassWorkshop, AvailabilitySlot,
// WorkshopSession and Assignment.
//
// Conventions:
// - cuid() ids
// - soft delete via `deletedAt` on User and School; HARD delete on the
//   scheduling models (use status enums for lifecycle, not deletedAt)
// - Teacher is inlined as `User.schoolId?` (extract to a Teacher table later
//   if it grows real fields; see AGENTS.md). Class-specific fields live on
//   ClassSection, not User.
// - Concrete session and candidate availability instants are stored UTC.
//   Recurring weekly slots (ClassMeeting) are NOT instants: they store
//   `dayOfWeek` + `startMinute`/`endMinute` as LOCAL wall-clock
//   (America/Vancouver), combined with an admin-selected date to produce a UTC instant.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  TEACHER
  PA
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          Role      @default(PA)

  // Populated when role = TEACHER. App logic enforces.
  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  accounts       Account[]
  sessions       Session[]
  availabilities Availability[]

  // Scheduling domain (back-relations)
  classesTaught          ClassSection[]                @relation("TeacherClasses") // role = TEACHER
  assignments            Assignment[]                  @relation("SessionAssignments")
  monthlyQuotas          MonthlyPAQuota[]
  availabilityExceptions PAAvailabilityException[]
  availabilityVersions   AvailabilityScheduleVersion[]
  autoFillExclusions      AutoFillExclusion[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([role])
  @@index([schoolId])
  @@index([deletedAt])
}

model School {
  id   String @id @default(cuid())
  name String

  teachers      User[]
  classSections ClassSection[]
  closures      SchoolClosure[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([deletedAt])
}

// Weekly-recurring availability. One row per ticked 15-minute slot, Mon–Fri
// during school hours (8:30 AM–3:00 PM). Resolving weekly slots to concrete
// dates is the scheduler's job, not this schema's. Hard delete (AGENTS.md
// default for new models).
model Availability {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayOfWeek      Int // 0=Mon … 4=Fri (matches the grid UI ordering; no weekends)
  startMin       Int // Vancouver minutes from midnight; 15-minute slots.
  effectiveFrom  DateTime  @default(dbgenerated("'2000-01-01'::date")) @db.Date
  effectiveUntil DateTime? @db.Date
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, dayOfWeek, startMin, effectiveFrom])
  @@index([dayOfWeek, startMin])
}

model AvailabilityScheduleVersion {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  effectiveFrom  DateTime  @db.Date
  effectiveUntil DateTime? @db.Date
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  @@unique([userId, effectiveFrom])
}

// --- Scheduling domain ---
// Hard delete. Lifecycle is tracked via status enums, not `deletedAt`.

// One implicit scheduling profile per teacher. The legacy table/model name is
// retained to preserve availability, enrollment, session IDs and historical links.
// Administrators manage this through the teacher; there is no separate class setup.
model ClassSection {
  id                     String  @id @default(cuid())
  name                   String // Mirrored teacher display name; not separately editable.
  subject                String?
  grade                  String?
  monthlyCadence         Int     @default(1)
  defaultDurationMinutes Int     @default(60)
  defaultMinPAs          Int     @default(1)
  defaultMaxPAs          Int     @default(3)

  teacherId String @unique
  teacher   User   @relation("TeacherClasses", fields: [teacherId], references: [id])
  schoolId  String
  school    School @relation(fields: [schoolId], references: [id])

  meetings               ClassMeeting[]
  classWorkshops         ClassWorkshop[]
  availabilitySlots      AvailabilitySlot[]
  availabilityExceptions ClassAvailabilityException[]
  archivedAt             DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId])
  @@index([schoolId])
}

// Effective Vancouver weekly availability. Only activeForScheduling rows authorize
// new dates; inactive legacy rows remain reference information.
model ClassMeeting {
  id             String       @id @default(cuid())
  classSectionId String
  classSection   ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)

  dayOfWeek           Int // 0=Mon … 4=Fri (matches Availability; no weekends)
  startMinute         Int // minutes from local midnight
  endMinute           Int
  effectiveFrom       DateTime  @default(dbgenerated("'2000-01-01'::date")) @db.Date
  effectiveUntil      DateTime? @db.Date
  activeForScheduling Boolean   @default(false)
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now()) @updatedAt

  @@index([classSectionId])
}

enum WorkshopStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  CANCELLED
}

// Imported runs may need identification; number is a legacy reference, not identity.
enum WorkshopIdentityStatus {
  IDENTIFIED
  NEEDS_IDENTIFICATION
}

// One named delivery run with a shared inclusive date window.
model WorkshopDefinition {
  id               String                 @id @default(cuid())
  number           Int?
  identityStatus   WorkshopIdentityStatus @default(IDENTIFIED)
  revision         Int                    @default(0)
  title            String
  description      String?
  durationMinutes  Int?
  defaultMinPAs    Int                    @default(1)
  defaultMaxPAs    Int                    @default(3)
  // Inclusive Vancouver calendar dates, not UTC delivery instants.
  deliveryStartsOn DateTime?              @db.Date
  deliveryEndsOn   DateTime?              @db.Date
  classWorkshops   ClassWorkshop[]
  draftStaffingOperations DraftStaffingOperation[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
}

enum ClassWorkshopStatus {
  NEEDS_AVAILABILITY
  READY_TO_SCHEDULE
  SCHEDULED
  COMPLETED
  CANCELLED
  WAIVED
}

model ClassWorkshop {
  id                   String              @id @default(cuid())
  classSectionId       String
  classSection         ClassSection        @relation(fields: [classSectionId], references: [id])
  workshopDefinitionId String
  workshopDefinition   WorkshopDefinition  @relation(fields: [workshopDefinitionId], references: [id])
  status               ClassWorkshopStatus @default(NEEDS_AVAILABILITY)
  notes                String?
  revision             Int                 @default(0)
  waivedAt             DateTime?
  waivedById           String?
  waiverReason         String?
  availabilitySlots    AvailabilitySlot[]
  sessions             WorkshopSession[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@unique([classSectionId, workshopDefinitionId])
  @@index([workshopDefinitionId])
}

model AvailabilitySlot {
  id              String         @id @default(cuid())
  // Exactly one owner: class-wide availability, or a previously recorded
  // workshop-specific candidate / confirmed direct booking.
  classSectionId  String?
  classSection    ClassSection?  @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  classWorkshopId String?
  classWorkshop   ClassWorkshop? @relation(fields: [classWorkshopId], references: [id], onDelete: Cascade)
  start           DateTime
  end             DateTime
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([classWorkshopId, start, end])
  @@unique([classSectionId, start, end])
}

enum SessionMode {
  IN_PERSON
  ONLINE
}

// An admin-created dated occurrence. Matching may only change assignments.
// The Vancouver-local start date determines the planning month.
model WorkshopSession {
  id              String         @id @default(cuid())
  classWorkshopId String
  classWorkshop   ClassWorkshop  @relation(fields: [classWorkshopId], references: [id])
  batchId         String?
  batch           WorkshopBatch? @relation(fields: [batchId], references: [id])

  scheduledStart          DateTime // UTC; required before staffing
  scheduledEnd            DateTime
  minPAs                  Int            @default(1)
  maxPAs                  Int            @default(3)
  status                  WorkshopStatus @default(DRAFT)
  version                 Int            @default(0)
  locked                  Boolean        @default(false)
  hostingConfirmed        Boolean        @default(false)
  publishedAt             DateTime?
  mode                    SessionMode    @default(IN_PERSON)
  location                String?
  notes                   String?
  participantInstructions String?
  dateExceptionReason     String?
  dateExceptionApprovedBy String?
  dateExceptionApprovedAt DateTime?
  availabilityBasis       Json?
  hostTeacherName         String?
  hostClassName           String?
  hostSchoolName          String?

  assignments Assignment[]
  changes     WorkshopChange[]
  events      WorkshopEvent[]
  autoFillExclusions AutoFillExclusion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scheduledStart])
  @@index([classWorkshopId])
  @@index([status])
  @@map("Workshop")
}

model WorkshopBatch {
  id          String            @id @default(cuid())
  requestKey  String            @unique
  actorId     String
  month       String
  payloadHash String
  createdAt   DateTime          @default(now())
  workshops   WorkshopSession[]
}

model MatchingPreview {
  id        String    @id @default(cuid())
  actorId   String
  month     String
  classIds  Json
  inputHash String
  plan      Json
  createdAt DateTime  @default(now())
  expiresAt DateTime
  appliedAt DateTime?
}

// Private draft command receipts: retries and Undo never restore a whole schedule.
model DraftStaffingOperation {
  id                   String   @id @default(cuid())
  requestKey           String   @unique
  actorId              String
  workshopDefinitionId String
  workshopDefinition   WorkshopDefinition @relation(fields: [workshopDefinitionId], references: [id], onDelete: Cascade)
  payloadHash          String
  kind                 String
  summary              String
  changes              Json
  createdAt            DateTime @default(now())
  undoneAt             DateTime?
  undoRequestKey       String? @unique
  undoActorId          String?

  @@index([workshopDefinitionId, actorId, createdAt])
}

// A manual removal is a session-specific choice, not global PA unavailability.
model AutoFillExclusion {
  id                String @id @default(cuid())
  workshopSessionId String
  workshopSession   WorkshopSession @relation(fields: [workshopSessionId], references: [id], onDelete: Cascade)
  paId              String
  pa                User @relation(fields: [paId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())

  @@unique([workshopSessionId, paId])
  @@index([paId])
}

// Durable acknowledgement of an atomic publication request, including lost responses.
model PublicationReceipt {
  requestKey  String   @id
  actorId     String
  payloadHash String
  sessionIds  Json
  createdAt   DateTime @default(now())
}

model WorkshopChange {
  id                String          @id @default(cuid())
  workshopSessionId String          @map("workshopId")
  workshopSession   WorkshopSession @relation(fields: [workshopSessionId], references: [id], onDelete: Cascade)
  actorId           String
  payload           Json
  before            Json
  proposed          Json
  createdAt         DateTime        @default(now())
  appliedAt         DateTime?

  @@index([workshopSessionId], map: "WorkshopChange_workshopId_idx")
}

model WorkshopEvent {
  id                String          @id @default(cuid())
  workshopSessionId String          @map("workshopId")
  workshopSession   WorkshopSession @relation(fields: [workshopSessionId], references: [id], onDelete: Cascade)
  actorId           String
  actorName         String
  kind              String
  reason            String
  before            Json
  after             Json
  wasPublished      Boolean
  affectedPAIds     String[]
  communicatedAt    DateTime?
  communicatedById  String?
  communicationNote String?
  createdAt         DateTime        @default(now())

  @@index([workshopSessionId, createdAt], map: "WorkshopEvent_workshopId_createdAt_idx")
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
}

enum AssignmentSource {
  MANUAL
  AUTOMATIC
}

model MonthlyPAQuota {
  id    String @id @default(cuid())
  paId  String
  pa    User   @relation(fields: [paId], references: [id], onDelete: Cascade)
  month String
  quota Int

  @@unique([paId, month])
  @@index([month])
}

// The singleton also serializes scheduling writes across workshops and PAs.
model SchedulingSettings {
  id                Int  @id @default(1)
  minimumGapDays    Int? @default(7)
  minimumGapMinutes Int? @ignore
  revision          Int  @default(0)
}

// A PA assigned by an admin. Drafts are private; published assignments are official.
model Assignment {
  id                   String           @id @default(cuid())
  workshopSessionId    String           @map("workshopId")
  workshopSession      WorkshopSession  @relation(fields: [workshopSessionId], references: [id], onDelete: Cascade)
  paId                 String
  pa                   User             @relation("SessionAssignments", fields: [paId], references: [id])
  status               AssignmentStatus @default(DRAFT)
  source               AssignmentSource @default(MANUAL)
  overrideAvailability Boolean          @default(false)
  overrideSameDay      Boolean          @default(false)
  overrideWeek         Boolean          @default(false)
  overrideReason       String?
  assignedAt           DateTime         @default(now())

  @@unique([workshopSessionId, paId], map: "Assignment_workshopId_paId_key")
  @@index([paId])
}

enum ClassAvailabilityExceptionKind {
  CLOSED
  ADDITIONAL
}

model ClassAvailabilityException {
  id             String                         @id @default(cuid())
  classSectionId String
  classSection   ClassSection                   @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  date           DateTime                       @db.Date
  kind           ClassAvailabilityExceptionKind
  startMinute    Int?
  endMinute      Int?
  notes          String?
  createdAt      DateTime                       @default(now())
  updatedAt      DateTime                       @updatedAt

  @@index([classSectionId, date])
}

model SchoolClosure {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  startMinute Int?
  endMinute   Int?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([schoolId, date])
}

enum PAAvailabilityExceptionKind {
  UNAVAILABLE
  AVAILABLE
}

model PAAvailabilityException {
  id          String                      @id @default(cuid())
  userId      String
  user        User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime                    @db.Date
  kind        PAAvailabilityExceptionKind
  startMinute Int?
  endMinute   Int?
  notes       String?
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt

  @@index([userId, date])
}

model EnrollmentBatch {
  id          String   @id @default(cuid())
  requestKey  String   @unique
  actorId     String
  payloadHash String
  createdAt   DateTime @default(now())
}

// --- NextAuth adapter tables ---
// Required by @auth/prisma-adapter. Do not modify field names.

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
