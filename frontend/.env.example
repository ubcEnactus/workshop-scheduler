# =============================================================================
# Workshop Scheduler — environment variables
# Copy this file to .env.local and fill in real values for local development.
# In Vercel, set these per environment (Production / Preview / Development).
# =============================================================================

# --- Database (Neon Postgres) ---
# Pooled connection URL used by the Next.js runtime. Required.
# From Neon dashboard: "Connection string" with pooling enabled (port 5432 pooler).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/DB?sslmode=require"

# Direct (non-pooled) connection used by Prisma for migrations.
# From Neon dashboard: "Connection string" with pooling DISABLED.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/DB?sslmode=require"

# --- Auth.js (NextAuth v5) ---
# Generate locally with: npx auth secret  (or `openssl rand -base64 32`)
AUTH_SECRET="replace-me-with-a-random-32-byte-base64-string"

# Trust the host header. Set to true on Vercel; leave unset locally.
# AUTH_TRUST_HOST=true

# --- Resend (magic-link email provider) ---
# Create an API key at https://resend.com/api-keys. Required for production login.
# Local dev: leave blank — the magic-link URL will be console-logged instead.
AUTH_RESEND_KEY=""

# The "From" address. Must be on a verified Resend sending domain in production.
# For dev, anything is fine (it's only used when AUTH_RESEND_KEY is set).
AUTH_RESEND_FROM="Workshop Scheduler <no-reply@example.com>"
